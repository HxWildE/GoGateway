    },
    {
      "id": "text_redis_body",
      "type": "text",
      "x": 810,
      "y": 140,
      "width": 300,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "text": "• Problem: GET + INCR race condition\n• Solution: Atomic Redis Lua Script\n\nlocal cur = redis.call('INCR', KEYS[1])\nif cur == 1 then redis.call('EXPIRE', ...)\nif cur > limit then return 0 (Drop)\nelse return 1 (Pass)\n\nGuarantees zero multi-threaded race conditions!",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "seed": 209,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false
    }
  ],
