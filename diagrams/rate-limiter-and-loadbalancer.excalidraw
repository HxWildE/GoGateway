      "type": "text",
      "x": 810,
      "y": 100,
      "width": 300,
      "height": 30,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "text": "⚡ Distributed Redis Lua",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "seed": 208,
      "version": 1,
      "versionNonce": 1,
